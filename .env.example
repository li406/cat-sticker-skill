# Cat Sticker Skill — Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# Required: Volcengine / Ark API Key (Seedream)
ARK_API_KEY=

# Optional: Override default Seedream model ID
# CAT_STICKER_SEEDREAM_MODEL=doubao-seedream-4-5-251128

# Optional: Override default workspace directory
# Default: %LOCALAPPDATA%\CatStickerSkill\workspace (Windows)
#           ~/.local/share/cat-sticker-skill/workspace (Linux/macOS)
# CAT_STICKER_HOME=

# Optional: Generation safety limits
# CAT_STICKER_MAX_RETRIES=2
# CAT_STICKER_REQUEST_TIMEOUT=120
# CAT_STICKER_UNIT_PRICE_CNY=0.25

# Optional: Private regression fixtures (outside repo, never committed)
# CAT_STICKER_PRIVATE_FIXTURES=
